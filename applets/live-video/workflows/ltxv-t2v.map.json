    "prefix": [{ "node": "80", "input": "filename_prefix" }]
  },
  "models": {
    "checkpoint": { "node": "44", "input": "ckpt_name", "url": "https://huggingface.co/Lightricks/LTX-Video/resolve/main/ltxv-2b-0.9.8-distilled.safetensors", "dir": "checkpoints" },
    "textEncoder": { "node": "38", "input": "clip_name", "url": "https://huggingface.co/comfyanonymous/flux_text_encoders/resolve/main/t5xxl_fp16.safetensors", "dir": "text_encoders" }
  },
  "outputs": { "video": "80", "lastFrame": "91" }
}
