{
  "id": "ltxv-t2v",
  "label": "LTX-Video 2B · fast",
  "kind": "t2v",
  "family": "ltxv",
  "i2v": "ltxv-i2v",
  "workflow": "ltxv-t2v.api.json",
  "vramMb": 12000,
