  "defaults": { "width": 768, "height": 512, "seconds": 3, "fps": 24 },
  "limits": { "sizeStep": 32, "maxWidth": 1280, "maxHeight": 720, "framesStep": 8, "framesOffset": 1, "maxFrames": 257 },
